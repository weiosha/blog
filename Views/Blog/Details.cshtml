@model BlogApp.Models.Post

<!DOCTYPE html>
<html>
<head>
    <title>@Model.Title</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            padding: 30px;
        }

        .card {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 30px;
            max-width: 600px;
        }

        h1 {
            color: #8B0000;
            margin-bottom: 5px;
        }

        .author {
            color: #888;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .content {
            font-size: 16px;
            line-height: 1.6;
            color: #333;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #8B0000;
            text-decoration: none;
            font-weight: bold;
        }

        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>@Model.Title</h1>
        <p class="author">Written by @Model.Author</p>
        <div class="content">
            <p>@Model.Content</p>
        </div>
        <a class="back-link" href="/Blog">Back to Posts</a>
    </div>

</body>
</html>