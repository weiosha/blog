@model IEnumerable<BlogApp.Models.Post>

<h1>Blog Posts</h1>

<table>
    <tr>
        <th>Title</th>
        <th>Author</th>
    </tr>
    @foreach (var post in Model)
    {
        <tr>
            <td>
                <a href="/Blog/Details/@post.Id">@post.Title</a>
            </td>
            <td>@post.Author</td>
        </tr>
    }
</table>